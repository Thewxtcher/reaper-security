{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "friend_request",
        "friend_accept",
        "message",
        "mention",
        "system"
      ],
      "default": "system"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "from_email": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "title"
  ]
}