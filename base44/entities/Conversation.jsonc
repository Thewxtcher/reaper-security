{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "dm",
        "group"
      ],
      "default": "dm"
    },
    "name": {
      "type": "string"
    },
    "participant_emails": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participant_names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_message": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string"
    },
    "created_by": {
      "type": "string"
    },
    "pinned": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "participant_emails"
  ]
}